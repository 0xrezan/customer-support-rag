# ── Application ──────────────────────────────────────────────
APP_NAME=customer-support-bot
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ── FastAPI ─────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_HOST_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Admin Auth ──────────────────────────────────────────────
# Required for admin API. Use a random 32+ character value.
ADMIN_API_TOKEN=
# Optional Telegram admin allowlist, e.g. [123456789].
ADMIN_TELEGRAM_IDS=[]

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot_secret
POSTGRES_DB=support_bot
DATABASE_URL=postgresql+asyncpg://bot:bot_secret@localhost:5432/support_bot

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_HOST_PORT=8100
CHROMA_COLLECTION_PREFIX=kb

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.1

# ── Anthropic (опционально) ─────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.1

# ── LLM Provider Selection ──────────────────────────────────
LLM_PROVIDER=openai

# ── RAG Settings ────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MIN_HIT_COUNT=1

# ── Cache ───────────────────────────────────────────────────
ANSWER_CACHE_TTL_SECONDS=300

# ── Dramatiq Worker ─────────────────────────────────────────
DRAMATIQ_BROKER_URL=redis://localhost:6379/1

# ── Phase 2: Reranking ──────────────────────────────────────
RERANKING_ENABLED=true
RERANKING_KEYWORD_WEIGHT=0.3
RERANKING_SEMANTIC_WEIGHT=0.7

# ── Phase 2: Hybrid Retrieval ───────────────────────────────
HYBRID_RETRIEVAL_ENABLED=false
HYBRID_DENSE_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3

# ── Phase 2: Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# ── Phase 2: Chat Cleanup ───────────────────────────────────
CHAT_RETENTION_DAYS=90

# ── Upload Safety ────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".txt",".md",".markdown"]
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf","application/octet-stream","text/markdown","text/plain"]
